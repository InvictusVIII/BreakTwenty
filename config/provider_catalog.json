    "backend": {
      "networkPreflight": { "host": "ndcdyn.interactivebrokers.com" },
      "connector": {
        "modulePath": "app.connectors.ibkr_flex",
        "className": "IBKRFlexConnector",
        "providerType": "api",
        "persistedProvider": "ibkr",
        "syncStatusProvider": "ibkr",
        "errorStatus": "error_flex"
      },
      "route": {
        "syncPath": "/sync/flex",
        "lockProvider": "ibkr",
        "statusProvider": "ibkr",
        "errorStatus": "error_flex"
      },
      "runtimeState": {
        "artifactKinds": [],
        "browserEngine": "none",
        "authMode": "api",
        "reuseMode": "api_credentials"
      },
      "nightly": {
        "enabled": true,
        "phase": "api",
        "order": 10
      },
      "transactionImport": {
        "enabled": true,
        "dailyDedupe": true
      },
      "settingInvalidationKeys": [
        "ibkr_flex_token",
        "ibkr_flex_query_id"
      ],
      "configuredSettingsAllOf": [
        "ibkr_flex_token",
        "ibkr_flex_query_id"
      ]
    }
  },
  "questrade": {
    "displayName": "Questrade",
    "institutionType": "api",
    "category": "bank_brokerage",
    "availableInAddList": true,
    "implemented": true,
    "logo": {
      "asset": "questrade.png"
    },
    "frontend": {
      "addAuthModal": "api",
      "backgroundSyncEndpoint": "/sync/questrade",
      "apiConfig": {
        "fields": [
          {
            "key": "questrade_refresh_token",
            "label": "Refresh Token",
            "type": "password"
          }
        ],
        "description": "Connect your Questrade accounts to sync positions and balances automatically. You only need to paste a refresh token once — BreakTwenty rotates it automatically on every sync.",
        "instructionsTitle": "How to get your refresh token:",
        "instructionsSteps": [
          {
            "text": "Log into ",
            "link": "https://www.questrade.com/api/documentation/getting-started",
            "linkText": "Questrade API Hub"
          },
          {
            "text": "Go to **App Hub** and register a new personal app (or use an existing one)"
          },
          {
            "text": "Under your app, click **Generate new token**"
          },
          {
            "text": "Copy the **Refresh Token** and paste it below"
          },
          {
            "text": "Tokens expire in 3 days if unused — daily auto-sync keeps it alive"
          }
        ]
      }
    },
    "backend": {
      "networkPreflight": { "host": "login.questrade.com" },
      "connector": {
        "modulePath": "app.connectors.questrade",
        "className": "QuestradeConnector",
        "providerType": "api"
      },
      "route": {
        "syncPath": "/sync/questrade"
      },
      "runtimeState": {
        "artifactKinds": [],
        "browserEngine": "none",
        "authMode": "api",
        "reuseMode": "oauth_settings"
      },
      "nightly": {
        "enabled": true,
        "phase": "api",
        "order": 20
      },
      "transactionImport": {
        "enabled": true
      },
      "settingInvalidationKeys": [
        "questrade_refresh_token"
      ],
      "transientSettingKeys": [
        "questrade_access_token",
        "questrade_api_server"
      ],
      "configuredSettingsAllOf": [
        "questrade_refresh_token"
      ]
    }
  },
  "coinbase": {
    "displayName": "Coinbase",
    "institutionType": "api",
    "category": "crypto_wallet",
    "availableInAddList": true,
    "implemented": true,
    "logo": {
      "asset": "coinbase.png"
    },
    "frontend": {
      "addAuthModal": "api",
      "backgroundSyncEndpoint": "/sync/coinbase",
      "apiConfig": {
        "fields": [
          {
            "key": "coinbase_api_key",
            "label": "API Key Name",
            "type": "text"
          },
          {
            "key": "coinbase_api_secret",
            "label": "API Secret (Private Key)",
            "type": "password",
            "multiline": true
          }
        ],
        "description": "Connect your Coinbase account to sync crypto holdings and balances automatically. Uses a read-only Coinbase Advanced API key from your regular Coinbase account.",
        "instructionsTitle": "How to get your API credentials:",
        "instructionsSteps": [
          {
            "text": "Sign in to your regular Coinbase account and open **Advanced API** from the left menu"
          },
          {
            "text": "Click **Create API key**"
          },
          {
            "text": "Keep the default read-only **View** permission and **Signature algorithm** selected"
          },
          {
            "text": "Choose the Coinbase **portfolio** you want BreakTwenty to sync"
          },
          {
            "text": "Click **Create & download**, then copy the **API Key Name** and **Private Key** into BreakTwenty"
          },
          {
            "text": "The downloaded private key is only available once — save it securely"
          }
        ]
      }
    },
    "backend": {
      "networkPreflight": { "host": "api.coinbase.com" },
      "connector": {
        "modulePath": "app.connectors.coinbase",
        "className": "CoinbaseConnector",
        "providerType": "api"
      },
      "route": {
        "syncPath": "/sync/coinbase"
      },
      "runtimeState": {
        "artifactKinds": [],
        "browserEngine": "none",
        "authMode": "api",
        "reuseMode": "api_credentials"
      },
      "nightly": {
        "enabled": true,
        "phase": "api",
        "order": 30
      },
      "transactionImport": {
        "enabled": true
      },
      "settingInvalidationKeys": [
        "coinbase_api_key",
        "coinbase_api_secret"
      ],
      "configuredSettingsAllOf": [
        "coinbase_api_key",
        "coinbase_api_secret"
      ]
    }
  },
