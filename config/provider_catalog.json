{
  "$schema": "./provider_catalog.schema.json",
  "ibkr": {
    "displayName": "Interactive Brokers",
    "institutionType": "api",
    "category": "bank_brokerage",
    "availableInAddList": true,
    "implemented": true,
    "logo": {
      "asset": "ibkr.png",
      "aliases": [
        "interactive brokers",
        "ibkr"
      ]
    },
    "frontend": {
      "addAuthModal": "api",
      "backgroundSyncEndpoint": "/sync/flex",
      "userInitiatedSyncEndpoint": "/sync/ibkr/scrape",
      "scraperEndpoints": {
        "login": "/sync/ibkr/login",
        "twofa": "/sync/ibkr/2fa"
      },
      "scraperFieldLabels": {
        "username": "Username",
        "password": "Password"
      },
      "scraperAuth": {
        "clearCredentialsBeforeNewLogin": true,
        "flow": "desktop_visible_auth",
        "desktopVisibleAuth": {
          "enabled": true,
          "addFlow": false,
          "manualFlow": true,
          "recordHar": true,
          "stageArtifacts": true,
          "displayName": "Interactive Brokers",
          "localeEnvMode": "inherit",
          "requireCredentialsBeforeLaunch": false,
          "waitStep": "desktop_visible_auth_wait",
          "timeoutSeconds": 0,
          "statusPollMs": 2000,
          "syncRetryMs": 2000,
          "syncRetryAttempts": 30,
          "runnerCommand": [
            "breaktwenty-visible-auth-python",
            "scripts/ibkr_visible_auth.py"
          ]
        }
      },
      "apiConfig": {
        "fields": [
          {
            "key": "ibkr_flex_query_id",
            "label": "Query ID",
            "type": "text"
          },
          {
            "key": "ibkr_flex_token",
            "label": "Flex Query Token",
            "type": "password"
          }
        ],
        "description": "Connect your IBKR account using Flex Queries to automatically pull account data daily. Data is end-of-day (delayed a few hours).",
        "instructionsTitle": "How to get your Flex Query credentials:",
        "instructionsSteps": [
          {
            "text": "Log into ",
            "link": "https://www.interactivebrokers.com/portal",
            "linkText": "IBKR Account Management"
          },
          {
            "text": "Go to **Performance & Reports → Flex Queries**"
          },
          {
            "text": "Create an **Activity Flex Query** and add these sections: **Account Information**, **Net Asset Value (NAV) in Base**, **Open Positions**, **Cash Report**, **Cash Transactions**, and **Trades** — click **Select All** for each"
          },
          {
            "text": "Note the **Query ID** shown next to your query"
          },
          {
            "text": "Under **Flex Web Service**, generate or copy your **Token**"
          }
        ]
      },
      "dashboardAuth": {
        "authRequired": {
          "modal": "scraper",
          "skipAutoLogin": false
        },
        "credentialErrorByStatus": {
          "error_flex": {
            "modal": "api"
          }
        },
        "credentialErrorDefault": {
          "modal": "scraper",
          "skipAutoLogin": false
        }
      },
      "syncDisplay": {
        "messageAppends": [
          {
            "messageIncludes": "token has expired",
            "append": "Update your IBKR Flex token in Settings."
          }
        ]
      }
    },
    "backend": {
      "networkPreflight": { "host": "portal.interactivebrokers.com" },
      "connector": {
        "modulePath": "app.connectors.ibkr_scraper",
        "className": "IBKRScraperConnector",
        "providerType": "scraper",
        "errorStatus": "error_scraper"
      },
      "route": {
        "syncPath": "/sync/ibkr/scrape",
        "loginPath": "/sync/ibkr/login",
        "twofaPath": "/sync/ibkr/2fa",
        "authHandler": "standard_scraper",
        "missingCredentialsMessage": "Username and password required",
        "errorStatus": "error_scraper"
      },
      "runtimeState": {
        "artifactKinds": [
          "storage_state",
          "session"
        ],
        "browserEngine": "httpx",
        "silentReuseEngine": "httpx",
        "manualAuthEngine": "desktop_patchright",
        "manualAuthMode": "desktop_visible_auth",
        "authMode": "scraper_api",
        "reuseMode": "storage_state_session",
        "credentialChangeQuarantine": true,
        "desktopAuthRuntimeDir": true,
        "pendingRuntimeNamespaces": [
          "ibkr"
        ]
      }
    }
  },
  "ibkr_flex": {
    "displayName": "Interactive Brokers",
    "institutionType": "api",
    "availableInAddList": false,
    "implemented": true,
    "logo": {
      "asset": "ibkr.png",
      "aliases": [
        "interactive brokers",
        "ibkr"
      ]
