{
  "name": "breaktwenty-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource/inter": "^5.3.0",
    "echarts": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.0"
  },
  "scripts": {
    "start": "node scripts/generate-theme-css.js && node scripts/start.js",
    "build": "node scripts/syncProviderCatalog.js && node scripts/syncLoadingScreen.js && node scripts/generate-theme-css.js && vite build",
    "test": "node scripts/syncProviderCatalog.js --check && node scripts/syncLoadingScreen.js --check && vitest",
    "generate:theme": "node scripts/generate-theme-css.js",
    "generate:theme:check": "node scripts/generate-theme-css.js --check",
    "sync:provider-catalog": "node scripts/syncProviderCatalog.js",
    "sync:provider-catalog:check": "node scripts/syncProviderCatalog.js --check",
    "sync:loading-screen": "node scripts/syncLoadingScreen.js",
    "sync:loading-screen:check": "node scripts/syncLoadingScreen.js --check",
    "lint:js": "eslint \"src/**/*.{js,jsx}\"",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.0",
    "vite": "^8.1.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.9"
  }
}
